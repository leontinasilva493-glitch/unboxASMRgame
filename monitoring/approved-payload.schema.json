{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unboxasmrguide.site/schemas/approved-monitoring-payload.json",
  "title": "Approved monitoring payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["issueNumber", "sourceId", "verifiedAt", "gameVersion", "evidence", "operations"],
  "properties": {
    "issueNumber": { "type": "integer", "minimum": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "gameVersion": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["status", "verifiedAt"],
        "properties": {
          "status": { "enum": ["official", "in_game_verified", "community_reported"] },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "screenshot": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "op", "path", "value"],
        "properties": {
          "file": { "type": "string", "pattern": "^data/[a-z0-9-]+\\.json$" },
          "op": { "enum": ["add", "replace"] },
          "path": { "type": "string", "pattern": "^/" },
          "value": {}
        }
      }
    }
  }
}
